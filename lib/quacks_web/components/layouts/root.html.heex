<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-visual"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#3e2a16" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={QuacksWeb.PwaController.name()} />
    <%!-- Served by QuacksWeb.PwaController: name and icons differ on staging and dev. --%>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href={QuacksWeb.PwaController.icon("apple-touch-icon.png")} />
    <.live_title default="Quacks" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&display=swap"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-wood-dark text-parchment antialiased">
    <QuacksWeb.Icons.sprite />
    {@inner_content}
  </body>
</html>
